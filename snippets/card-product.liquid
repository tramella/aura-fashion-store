{%- if card_product and card_product != empty -%}
  <div class="aura-trending-card" data-aura-reveal="fade-up">
    <div class="aura-trending-card__media-wrap">
      <a href="{{ card_product.url }}" class="aura-trending-card__link">
        {%- if card_product.featured_media -%}
          <img
            srcset="{{ card_product.featured_media | image_url: width: 360 }} 360w, {{ card_product.featured_media | image_url: width: 720 }} 720w"
            src="{{ card_product.featured_media | image_url: width: 600 }}"
            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
            alt="{{ card_product.featured_media.alt | escape }}"
            loading="lazy"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
            class="aura-trending-card__img"
          >
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg aura-trending-card__img' }}
        {%- endif -%}
      </a>

      <!-- Wishlist Heart Icon -->
      <button type="button" class="aura-trending-card__wishlist" aria-label="Add to wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
      </button>

      <!-- Quick View Floating Button -->
      <button
        type="button"
        class="aura-trending-card__quick-btn aura-quick-view-trigger"
        data-product-handle="{{ card_product.handle }}"
      >
        Quick View
      </button>
    </div>

    <!-- Info below image (Clear & Bold) -->
    <div class="aura-trending-card__info">
      <h3 class="aura-trending-card__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      <div class="aura-trending-card__price-row">
        <span class="aura-trending-card__price">{{ card_product.price | money }}</span>
        {%- if card_product.compare_at_price > card_product.price -%}
          <span class="aura-trending-card__compare">{{ card_product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .aura-trending-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .aura-trending-card__media-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    overflow: hidden;
    background: #E8E5DF;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }

  .aura-trending-card__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .aura-trending-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .aura-trending-card:hover .aura-trending-card__img {
    transform: scale(1.05);
  }

  .aura-trending-card__wishlist {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0F0F11;
    z-index: 3;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .aura-trending-card__wishlist:hover {
    background: #FFFFFF;
    color: #EF4444;
    transform: scale(1.1);
  }

  .aura-trending-card__quick-btn {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    background: #0F0F11;
    color: #FFFFFF;
    border: none;
    border-radius: 9999px;
    padding: 8px 20px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    z-index: 4;
    white-space: nowrap;
    transition: all 200ms ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .aura-trending-card:hover .aura-trending-card__quick-btn {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .aura-trending-card__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    padding: 0 4px;
  }

  .aura-trending-card__title {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    margin: 0;
    color: #0F0F11 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em;
  }

  .aura-trending-card__title a {
    color: #0F0F11 !important;
    text-decoration: none !important;
  }

  .aura-trending-card__price-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .aura-trending-card__price {
    font-size: 1rem !important;
    font-weight: 800 !important;
    color: #0F0F11 !important;
  }

  .aura-trending-card__compare {
    font-size: 0.88rem !important;
    color: #9CA3AF !important;
    text-decoration: line-through !important;
  }
{% endstylesheet %}
