<div class="aura-register-page page-width py-16 flex items-center justify-center min-h-[60vh]">
  <div class="w-full max-w-md bg-white rounded-3xl border border-gray-200/80 p-8 md:p-10 shadow-lg">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">
        <span>Create Your</span>
        <span class="aura-serif-italic font-normal">Account</span>
      </h1>
      <p class="text-xs text-gray-500">Join AURA VIP for personalized recommendations and saved wishlist items.</p>
    </div>

    {%- form 'create_customer', class: 'space-y-4' -%}
      {{ form.errors | default_errors }}

      <div>
        <label for="FirstName" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">First Name</label>
        <input
          type="text"
          name="customer[first_name]"
          id="FirstName"
          autocomplete="given-name"
          placeholder="Jane"
          class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-black transition-colors"
        >
      </div>

      <div>
        <label for="LastName" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Last Name</label>
        <input
          type="text"
          name="customer[last_name]"
          id="LastName"
          autocomplete="family-name"
          placeholder="Doe"
          class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-black transition-colors"
        >
      </div>

      <div>
        <label for="Email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Email Address</label>
        <input
          type="email"
          name="customer[email]"
          id="Email"
          autocomplete="email"
          required
          placeholder="jane@example.com"
          class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-black transition-colors"
        >
      </div>

      <div>
        <label for="CreatePassword" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Password</label>
        <input
          type="password"
          name="customer[password]"
          id="CreatePassword"
          autocomplete="new-password"
          required
          placeholder="••••••••"
          class="w-full px-4 py-3 rounded-full border border-gray-300 text-sm focus:outline-none focus:border-black transition-colors"
        >
      </div>

      <button
        type="submit"
        class="w-full py-3.5 bg-black text-white text-xs font-extrabold uppercase tracking-widest rounded-full hover:bg-gray-800 transition-all shadow-md hover:shadow-lg mt-3"
      >
        Create Account
      </button>

      <div class="text-center pt-4 border-t border-gray-100">
        <p class="text-xs text-gray-500">
          Already have an account?
          <a href="{{ routes.account_login_url }}" class="font-bold text-black underline hover:text-gray-700 ml-1">Sign In</a>
        </p>
      </div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .aura-register-page {
    min-height: 60vh;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aura Register",
  "tag": "section",
  "class": "section-aura-register",
  "settings": []
}
{% endschema %}
