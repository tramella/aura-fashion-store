<footer class="aura-luneva-footer-section">
  <div class="page-width">
    <!-- Dark Newsletter Block -->
    <div class="aura-luneva-newsletter">
      <h2 class="aura-luneva-newsletter-title">
        <span>Subscribe Our</span>
        <span class="aura-serif-italic">Newsletters.</span>
      </h2>

      {%- form 'customer', class: 'aura-luneva-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="aura-luneva-newsletter-input-group">
          <input
            type="email"
            name="contact[email]"
            placeholder="Enter your email"
            required
            class="aura-luneva-newsletter-input"
          >
          <button type="submit" class="aura-btn aura-btn--white aura-luneva-newsletter-btn">Subscribe</button>
        </div>
      {%- endform -%}
    </div>

    <div class="aura-luneva-footer-divider"></div>

    <!-- 4 Columns Mega Footer Grid with Mobile Accordions -->
    <div class="aura-luneva-footer-grid">
      <div class="aura-luneva-col">
        <button type="button" class="aura-luneva-col-title-btn" aria-expanded="false">
          <span class="aura-luneva-col-title">Women</span>
          <svg class="aura-luneva-col-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/women">Tops &amp; Blouses</a></li>
          <li><a href="/collections/women">Dresses &amp; Jumpsuits</a></li>
          <li><a href="/collections/women">Blazers &amp; Outerwear</a></li>
          <li><a href="/collections/women">Pants &amp; Skirts</a></li>
          <li><a href="/collections/women">Denim</a></li>
          <li><a href="/collections/women">Shoes &amp; Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <button type="button" class="aura-luneva-col-title-btn" aria-expanded="false">
          <span class="aura-luneva-col-title">Men</span>
          <svg class="aura-luneva-col-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/men">Shirts &amp; Polos</a></li>
          <li><a href="/collections/men">T-Shirts &amp; Sweaters</a></li>
          <li><a href="/collections/men">Jackets &amp; Coats</a></li>
          <li><a href="/collections/men">Trousers &amp; Jeans</a></li>
          <li><a href="/collections/men">Footwear</a></li>
          <li><a href="/collections/men">Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <button type="button" class="aura-luneva-col-title-btn" aria-expanded="false">
          <span class="aura-luneva-col-title">Kids</span>
          <svg class="aura-luneva-col-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/kids">Girls</a></li>
          <li><a href="/collections/kids">Boys</a></li>
          <li><a href="/collections/kids">Baby</a></li>
          <li><a href="/collections/kids">Shoes &amp; Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <button type="button" class="aura-luneva-col-title-btn" aria-expanded="false">
          <span class="aura-luneva-col-title">The Company</span>
          <svg class="aura-luneva-col-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="aura-luneva-link-list">
          <li><a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">My Order</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/about">About Lunéva</a></li>
          <li><a href="/pages/faqs">FAQs</a></li>
          <li><a href="/pages/sitemap">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <!-- Ultra-Large Brand Logo at Bottom -->
    <div class="aura-footer-big-brand">
      <span>AURA</span>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const colBtns = document.querySelectorAll('.aura-luneva-col-title-btn');
    colBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          const parentCol = btn.closest('.aura-luneva-col');
          const isOpen = parentCol?.classList.contains('is-open');

          document.querySelectorAll('.aura-luneva-col').forEach(col => {
            if (col !== parentCol) {
              col.classList.remove('is-open');
              col.querySelector('.aura-luneva-col-title-btn')?.setAttribute('aria-expanded', 'false');
            }
          });

          if (isOpen) {
            parentCol?.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            parentCol?.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });
  });
</script>

{% stylesheet %}
  .aura-luneva-footer-section {
    background: #0F0F11;
    color: #FFFFFF;
    margin-top: 5rem !important;
    padding-top: 4.5rem;
    padding-bottom: 3rem;
    overflow: hidden;
    position: relative;
  }

  .aura-luneva-newsletter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  .aura-luneva-newsletter-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    margin: 0;
    color: #FFFFFF;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .aura-luneva-newsletter-form {
    width: 100%;
    max-width: 460px;
  }

  .aura-luneva-newsletter-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .aura-luneva-newsletter-input {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    padding: 12px 20px;
    font-size: 0.88rem;
    color: #FFFFFF;
    outline: none;
    transition: border-color 200ms ease;
  }

  .aura-luneva-newsletter-input:focus {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .aura-luneva-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .aura-luneva-newsletter-btn {
    white-space: nowrap;
    border-radius: 9999px;
    padding: 12px 24px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .aura-luneva-footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin-bottom: 3rem;
  }

  .aura-luneva-footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2.5rem;
    padding-bottom: 4rem;
  }

  .aura-luneva-col-title-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    color: #FFFFFF;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
    cursor: default;
  }

  .aura-luneva-col-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .aura-luneva-col-icon {
    display: none;
    transition: transform 300ms ease;
  }

  .aura-luneva-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .aura-luneva-link-list a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 200ms ease;
  }

  .aura-luneva-link-list a:hover {
    color: #FFFFFF;
  }

  /* Ultra-Large Brand Logo at Footer Bottom */
  .aura-footer-big-brand {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .aura-footer-big-brand span {
    font-family: var(--aura-font-serif-italic);
    font-size: clamp(4.5rem, 16vw, 13rem);
    font-weight: 700;
    line-height: 0.85;
    color: #FFFFFF;
    opacity: 0.95;
    letter-spacing: -0.03em;
    display: inline-block;
  }

  /* Mobile Responsive Optimization (Collapsible Accordion & Extra Bottom Space) */
  @media (max-width: 768px) {
    .aura-luneva-footer-section {
      margin-top: 3rem !important;
      padding-top: 2.5rem;
      padding-bottom: 5.5rem !important; /* Extra clearance for mobile bottom navbar */
    }

    .aura-luneva-newsletter {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding-bottom: 2rem;
    }

    .aura-luneva-newsletter-title {
      font-size: 1.75rem;
    }

    .aura-luneva-newsletter-form {
      max-width: 100%;
    }

    .aura-luneva-newsletter-input-group {
      flex-direction: row;
      gap: 8px;
    }

    .aura-luneva-newsletter-input {
      padding: 10px 16px;
      font-size: 0.84rem;
    }

    .aura-luneva-newsletter-btn {
      padding: 10px 18px;
      font-size: 0.84rem;
    }

    .aura-luneva-footer-divider {
      margin-bottom: 1.5rem;
    }

    .aura-luneva-footer-grid {
      display: flex;
      flex-direction: column;
      gap: 0 !important;
      padding-bottom: 2rem;
    }

    .aura-luneva-col {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .aura-luneva-col-title-btn {
      cursor: pointer;
      padding: 1rem 0;
      margin: 0;
    }

    .aura-luneva-col-title {
      font-size: 1rem;
    }

    .aura-luneva-col-icon {
      display: block;
    }

    .aura-luneva-col.is-open .aura-luneva-col-icon {
      transform: rotate(180deg);
    }

    .aura-luneva-link-list {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1), opacity 300ms ease, padding 300ms ease;
      gap: 0.6rem;
      padding-bottom: 0;
    }

    .aura-luneva-col.is-open .aura-luneva-link-list {
      max-height: 400px;
      opacity: 1;
      padding-bottom: 1.25rem;
    }

    .aura-luneva-link-list a {
      font-size: 0.85rem;
    }

    .aura-footer-big-brand {
      padding-top: 1.5rem;
    }

    .aura-footer-big-brand span {
      font-size: clamp(3rem, 16vw, 4.5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aura Lunéva Footer",
  "tag": "section",
  "class": "section-luneva-footer",
  "settings": []
}
{% endschema %}
