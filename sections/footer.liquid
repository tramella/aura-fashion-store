<footer class="aura-luneva-footer-section">
  <div class="page-width">
    <!-- Dark Newsletter Block -->
    <div class="aura-luneva-newsletter">
      <h2 class="aura-luneva-newsletter-title">
        <span>Subscribe Our</span>
        <span class="aura-serif-italic">Newsletters.</span>
      </h2>

      {%- form 'customer', class: 'aura-luneva-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="Enter your email"
          required
          class="aura-luneva-newsletter-input"
        >
        <button type="submit" class="aura-btn aura-btn--white">Subscribe</button>
      {%- endform -%}
    </div>

    <div class="aura-luneva-footer-divider"></div>

    <!-- 4 Columns Mega Footer Grid -->
    <div class="aura-luneva-footer-grid">
      <div class="aura-luneva-col">
        <h3 class="aura-luneva-col-title">Women</h3>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/women">Tops &amp; Blouses</a></li>
          <li><a href="/collections/women">Dresses &amp; Jumpsuits</a></li>
          <li><a href="/collections/women">Blazers &amp; Outerwear</a></li>
          <li><a href="/collections/women">Pants &amp; Skirts</a></li>
          <li><a href="/collections/women">Denim</a></li>
          <li><a href="/collections/women">Shoes &amp; Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <h3 class="aura-luneva-col-title">Men</h3>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/men">Shirts &amp; Polos</a></li>
          <li><a href="/collections/men">T-Shirts &amp; Sweaters</a></li>
          <li><a href="/collections/men">Jackets &amp; Coats</a></li>
          <li><a href="/collections/men">Trousers &amp; Jeans</a></li>
          <li><a href="/collections/men">Footwear</a></li>
          <li><a href="/collections/men">Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <h3 class="aura-luneva-col-title">Kids</h3>
        <ul class="aura-luneva-link-list">
          <li><a href="/collections/kids">Girls</a></li>
          <li><a href="/collections/kids">Boys</a></li>
          <li><a href="/collections/kids">Baby</a></li>
          <li><a href="/collections/kids">Shoes &amp; Accessories</a></li>
        </ul>
      </div>

      <div class="aura-luneva-col">
        <h3 class="aura-luneva-col-title">The Company</h3>
        <ul class="aura-luneva-link-list">
          <li><a href="/account">My Order</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/about">About AURA</a></li>
          <li><a href="/pages/faqs">FAQs</a></li>
          <li><a href="/pages/sitemap">Sitemap</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Giant Bottom Watermark Title -->
  <div class="aura-luneva-footer-watermark">
    <span>AURA</span>
  </div>
</footer>

{% stylesheet %}
  .aura-luneva-footer-section {
    background: #0F0F11;
    color: #FFFFFF;
    padding-top: 4rem;
    padding-bottom: 2rem;
    overflow: hidden;
    position: relative;
  }

  .aura-luneva-newsletter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .aura-luneva-newsletter {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .aura-luneva-newsletter-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    margin: 0;
    color: #FFFFFF;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .aura-luneva-newsletter-form {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 440px;
  }

  .aura-luneva-newsletter-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    padding: 12px 20px;
    font-size: 0.88rem;
    color: #FFFFFF;
    outline: none;
  }

  .aura-luneva-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .aura-luneva-footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin-bottom: 3rem;
  }

  .aura-luneva-footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2.5rem;
    padding-bottom: 4rem;
  }

  .aura-luneva-col-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 1.25rem 0;
    color: #FFFFFF;
  }

  .aura-luneva-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .aura-luneva-link-list li {
    margin-bottom: 0.65rem;
  }

  .aura-luneva-link-list a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 150ms ease;
  }

  .aura-luneva-link-list a:hover {
    color: #FFFFFF;
  }

  /* Giant Watermark Logo at Footer Bottom */
  .aura-luneva-footer-watermark {
    text-align: center;
    width: 100%;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .aura-luneva-footer-watermark span {
    font-family: var(--aura-font-serif-italic);
    font-style: italic;
    font-size: clamp(5rem, 22vw, 24rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 0.8;
    letter-spacing: -0.04em;
    display: block;
    user-select: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lunéva Footer",
  "tag": "section",
  "class": "section-luneva-footer",
  "settings": []
}
{% endschema %}
