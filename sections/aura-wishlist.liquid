<div class="aura-wishlist-page page-width py-10 md:py-16">
  <!-- Toast Notification -->
  <div id="AuraWishlistToast" class="fixed bottom-10 right-6 z-50 bg-black/90 backdrop-blur-md text-white px-5 py-3.5 rounded-2xl shadow-2xl text-xs font-bold uppercase tracking-wider flex items-center gap-3 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 border border-white/10">
    <span id="AuraWishlistToastIcon" class="text-amber-400 text-sm">✓</span>
    <span id="AuraWishlistToastMsg">Wishlist updated</span>
  </div>

  <!-- Page Header Banner -->
  <div class="aura-wishlist-header bg-gradient-to-br from-gray-950 via-gray-900 to-black rounded-3xl p-8 md:p-12 text-white shadow-2xl mb-8 relative overflow-hidden border border-white/10">
    <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full text-xs font-semibold tracking-widest uppercase text-amber-300 mb-4 border border-white/15 shadow-inner">
          <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          <span>Personal Boutique</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
          {{ section.settings.header_title | default: 'My Wishlist' }}
          <span class="aura-serif-italic font-normal text-amber-100" id="AuraWishlistCountText">(0 items)</span>
        </h1>
        <p class="text-gray-400 text-sm md:text-base mt-2 max-w-xl leading-relaxed">
          {{ section.settings.header_subtitle | default: 'Your saved fashion favorites and curated looks ready for checkout.' }}
        </p>
      </div>

      <!-- Header Action Buttons -->
      <div class="aura-wishlist-actions flex flex-wrap items-center gap-3">
        <button
          type="button"
          id="AuraMoveAllToCartBtn"
          class="aura-btn bg-white text-black hover:bg-amber-100 text-xs uppercase font-extrabold tracking-wider py-3.5 px-6 rounded-full transition-all shadow-lg hover:shadow-xl active:scale-95 hidden flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span>Move All To Bag</span>
        </button>

        <button
          type="button"
          id="AuraShareWishlistBtn"
          class="aura-btn bg-white/10 hover:bg-white/20 text-white text-xs uppercase font-bold tracking-wider py-3.5 px-5 rounded-full border border-white/20 backdrop-blur-md transition-all active:scale-95 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 100-2.684 3 3 0 000 2.684zm0 9a3 3 0 100-2.684 3 3 0 000 2.684z"/></svg>
          <span>Share</span>
        </button>

        <button
          type="button"
          id="AuraClearWishlistBtn"
          class="aura-btn bg-white/10 hover:bg-rose-500/30 text-white hover:text-rose-200 text-xs uppercase font-bold tracking-wider py-3.5 px-5 rounded-full border border-white/20 backdrop-blur-md transition-all active:scale-95 hidden flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <span>Clear All</span>
        </button>

        <a href="{{ routes.all_products_collection_url }}" class="aura-btn bg-white/15 hover:bg-white/25 text-white text-xs uppercase font-bold tracking-wider py-3.5 px-6 rounded-full border border-white/20 backdrop-blur-md transition-all">
          Explore Shop
        </a>
      </div>
    </div>
  </div>

  <!-- Unified Customer Portal Navigation Tabs -->
  <div class="flex items-center gap-2 md:gap-4 mb-8 border-b border-gray-200 overflow-x-auto pb-1">
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="pb-3 border-b-2 border-transparent font-bold text-xs md:text-sm uppercase tracking-wider text-gray-400 hover:text-black flex items-center gap-2 transition-all whitespace-nowrap">
      <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <span>Orders & Profile</span>
    </a>
    <a href="/pages/wishlist" class="pb-3 border-b-2 border-black font-extrabold text-xs md:text-sm uppercase tracking-wider text-black flex items-center gap-2 whitespace-nowrap">
      <svg class="w-4 h-4 text-rose-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      <span>Saved Wishlist</span>
    </a>
    <a href="{{ routes.account_addresses_url }}" class="pb-3 border-b-2 border-transparent font-bold text-xs md:text-sm uppercase tracking-wider text-gray-400 hover:text-black flex items-center gap-2 transition-all whitespace-nowrap">
      <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <span>Addresses</span>
    </a>
  </div>

  <!-- Wishlist Toolbar (Filter, Sort & View Mode) -->
  <div id="AuraWishlistToolbar" class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-gray-50/80 backdrop-blur-sm p-4 rounded-2xl border border-gray-200/80 hidden">
    <!-- Left Filter Tabs -->
    <div class="flex items-center gap-2">
      <button type="button" data-filter="all" class="aura-filter-btn active text-xs uppercase font-extrabold tracking-wider px-4 py-2 rounded-xl bg-black text-white transition-all shadow-sm">
        All Items (<span id="AuraFilterAllCount">0</span>)
      </button>
      <button type="button" data-filter="instock" class="aura-filter-btn text-xs uppercase font-bold tracking-wider px-4 py-2 rounded-xl bg-transparent text-gray-600 hover:text-black hover:bg-white transition-all">
        In Stock
      </button>
    </div>

    <!-- Right Controls: Sort + View Toggles -->
    <div class="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto">
      <!-- Sort Select -->
      <div class="relative">
        <select id="AuraWishlistSort" class="appearance-none bg-white border border-gray-200 rounded-xl px-4 py-2 pr-8 text-xs font-bold uppercase tracking-wider text-gray-700 cursor-pointer focus:outline-none focus:border-black">
          <option value="recent">Recently Added</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="title-az">Name: A to Z</option>
        </select>
        <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
        </div>
      </div>

      <!-- Layout Toggles -->
      <div class="flex items-center bg-white rounded-xl border border-gray-200 p-1 shadow-sm">
        <button type="button" id="AuraViewGridBtn" class="p-1.5 rounded-lg bg-black text-white transition-all" title="Grid View">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zm-12 6h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zm-12 6h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z"/></svg>
        </button>
        <button type="button" id="AuraViewListBtn" class="p-1.5 rounded-lg text-gray-400 hover:text-black transition-all" title="List View">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Wishlist Container -->
  <div id="AuraWishlistContainer" class="min-h-[350px]">
    <!-- Empty State -->
    <div id="AuraWishlistEmpty" class="flex flex-col items-center justify-center text-center py-16 px-6 bg-gradient-to-b from-gray-50/50 to-white rounded-3xl border border-gray-100 shadow-sm">
      <div class="w-20 h-20 rounded-full bg-rose-50 shadow-inner flex items-center justify-center text-rose-500 mb-6 border border-rose-100">
        <svg class="w-9 h-9 animate-pulse" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 tracking-tight">Your Lookbook is Empty</h2>
      <p class="text-gray-500 max-w-md text-sm mb-8 leading-relaxed">Discover our exclusive new collections and tap the heart icon on any piece to curate your personal wardrobe.</p>
      
      <!-- Category Quick Links -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-8 max-w-lg">
        <a href="{{ routes.all_products_collection_url }}" class="bg-gray-100 hover:bg-black hover:text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider text-gray-700 transition-all">New Arrivals</a>
        <a href="{{ routes.all_products_collection_url }}" class="bg-gray-100 hover:bg-black hover:text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider text-gray-700 transition-all">Best Sellers</a>
        <a href="{{ routes.all_products_collection_url }}" class="bg-gray-100 hover:bg-black hover:text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider text-gray-700 transition-all">Essentials</a>
      </div>

      <a href="{{ routes.all_products_collection_url }}" class="aura-btn aura-btn--primary px-8 py-4 rounded-full text-xs uppercase font-extrabold tracking-widest shadow-xl hover:shadow-2xl transition-all active:scale-95">
        Explore Collection
      </a>
    </div>

    <!-- Dynamic Wishlist Grid -->
    <div id="AuraWishlistGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 hidden">
      <!-- Cards rendered via JavaScript -->
    </div>
  </div>

  <!-- Fallback Recommendations Section (Curated Lookbook) -->
  {%- assign rec_collection = collections[section.settings.featured_collection] | default: collections.all -%}
  {%- if rec_collection != blank and rec_collection.products.size > 0 -%}
    <div class="mt-20 border-t border-gray-100 pt-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-600 block mb-1">Curated Recommendations</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">You May Also Admire</h2>
        </div>
        <a href="{{ rec_collection.url }}" class="text-xs font-extrabold uppercase tracking-widest text-black hover:underline flex items-center gap-1">
          <span>View All Products</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {%- for product in rec_collection.products limit: 4 -%}
          <div class="group bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div class="relative aspect-[3/4] bg-gray-100 overflow-hidden">
              <a href="{{ product.url }}" class="block w-full h-full">
                {%- if product.featured_media -%}
                  <img
                    src="{{ product.featured_media | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    width="600"
                    height="800"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  >
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                {%- endif -%}
              </a>
              {%- if product.compare_at_price > product.price -%}
                <span class="absolute top-3 left-3 bg-rose-600 text-white text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-md">Sale</span>
              {%- endif -%}
            </div>
            <div class="p-5 flex flex-col justify-between flex-1">
              <div>
                <span class="text-[10px] font-extrabold tracking-widest uppercase text-gray-400 block mb-1">AURA LUXURY</span>
                <h3 class="text-sm font-bold text-gray-900 line-clamp-1 mb-1">
                  <a href="{{ product.url }}" class="hover:text-black transition-colors">{{ product.title }}</a>
                </h3>
                <div class="text-sm font-extrabold text-gray-900 mb-4">{{ product.price | money }}</div>
              </div>
              <a href="{{ product.url }}" class="w-full py-3 bg-black text-white text-xs font-extrabold uppercase tracking-widest rounded-full text-center hover:bg-gray-800 transition-all shadow-md block">
                View Piece
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const STORAGE_KEY = 'aura_wishlist_items';
    const gridEl = document.getElementById('AuraWishlistGrid');
    const emptyEl = document.getElementById('AuraWishlistEmpty');
    const toolbarEl = document.getElementById('AuraWishlistToolbar');
    const countText = document.getElementById('AuraWishlistCountText');
    const filterAllCount = document.getElementById('AuraFilterAllCount');
    const clearBtn = document.getElementById('AuraClearWishlistBtn');
    const moveAllBtn = document.getElementById('AuraMoveAllToCartBtn');
    const shareBtn = document.getElementById('AuraShareWishlistBtn');
    const toast = document.getElementById('AuraWishlistToast');
    const toastMsg = document.getElementById('AuraWishlistToastMsg');
    const sortSelect = document.getElementById('AuraWishlistSort');
    const viewGridBtn = document.getElementById('AuraViewGridBtn');
    const viewListBtn = document.getElementById('AuraViewListBtn');
    const filterBtns = document.querySelectorAll('.aura-filter-btn');

    let currentFilter = 'all';
    let currentView = 'grid';

    function showToast(msg) {
      if (!toast) return;
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
      }, 2500);
    }

    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function saveWishlist(items) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('aura:wishlist:updated', { detail: { items } }));
      renderWishlist();
    }

    function removeItem(handle) {
      const items = getWishlist().filter(item => item.handle !== handle);
      saveWishlist(items);
      showToast('Piece removed from wishlist');
    }

    async function addToCart(variantId, btnEl, url) {
      if (!btnEl) return;
      btnEl.disabled = true;
      const originalText = btnEl.innerHTML;
      btnEl.innerHTML = `
        <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Adding...</span>
      `;

      try {
        if (!variantId) {
          throw new Error('No variant ID');
        }
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
        });
        if (res.ok) {
          showToast('Added to your shopping bag! 🛍️');
          btnEl.innerHTML = `✓ Added`;
          btnEl.classList.remove('bg-black');
          btnEl.classList.add('bg-emerald-600');
          
          fetch('/cart.js').then(r => r.json()).then(cart => {
            document.querySelectorAll('.aura-cart-badge-pill').forEach(b => b.textContent = cart.item_count || 0);
          });
          setTimeout(() => {
            btnEl.disabled = false;
            btnEl.innerHTML = originalText;
            btnEl.classList.remove('bg-emerald-600');
            btnEl.classList.add('bg-black');
          }, 2000);
        } else {
          throw new Error('Failed to add');
        }
      } catch (e) {
        showToast('Viewing product options...');
        window.location.href = url || '/collections/all';
      }
    }

    function renderWishlist() {
      let items = getWishlist();

      if (countText) {
        countText.textContent = `(${items.length} ${items.length === 1 ? 'item' : 'items'})`;
      }
      if (filterAllCount) {
        filterAllCount.textContent = items.length;
      }

      if (items.length === 0) {
        emptyEl?.classList.remove('hidden');
        toolbarEl?.classList.add('hidden');
        gridEl?.classList.add('hidden');
        clearBtn?.classList.add('hidden');
        moveAllBtn?.classList.add('hidden');
        if (gridEl) gridEl.innerHTML = '';
        return;
      }

      emptyEl?.classList.add('hidden');
      toolbarEl?.classList.remove('hidden');
      gridEl?.classList.remove('hidden');
      clearBtn?.classList.remove('hidden');
      moveAllBtn?.classList.remove('hidden');

      // Sorting Logic
      const sortVal = sortSelect?.value || 'recent';
      if (sortVal === 'price-low') {
        items.sort((a, b) => (parseFloat((a.price || '0').replace(/[^0-9.]/g, '')) || 0) - (parseFloat((b.price || '0').replace(/[^0-9.]/g, '')) || 0));
      } else if (sortVal === 'price-high') {
        items.sort((a, b) => (parseFloat((b.price || '0').replace(/[^0-9.]/g, '')) || 0) - (parseFloat((a.price || '0').replace(/[^0-9.]/g, '')) || 0));
      } else if (sortVal === 'title-az') {
        items.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
      }

      // Filter Logic
      if (currentFilter === 'instock') {
        items = items.filter(i => i.in_stock !== false);
      }

      // Render Layout
      if (gridEl) {
        if (currentView === 'list') {
          gridEl.className = 'flex flex-col gap-4';
          gridEl.innerHTML = items.map(item => `
            <div class="aura-wishlist-card group bg-white rounded-3xl border border-gray-100 p-4 sm:p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col sm:flex-row items-center justify-between gap-6" data-handle="${item.handle}">
              <div class="flex items-center gap-5 w-full sm:w-auto">
                <a href="${item.url || '#'}" class="w-24 h-32 sm:w-28 sm:h-36 rounded-2xl overflow-hidden bg-gray-100 shrink-0 block relative">
                  <img src="${item.image || 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-1_600x.png'}" alt="${item.title || 'Product'}" width="300" height="400" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                </a>
                <div>
                  <span class="text-[10px] font-extrabold tracking-widest uppercase text-gray-400 block mb-1">AURA LUXURY</span>
                  <h3 class="text-base font-bold text-gray-900 mb-1">
                    <a href="${item.url || '#'}" class="hover:text-amber-600 transition-colors">${item.title || 'Luxury Piece'}</a>
                  </h3>
                  <div class="text-base font-extrabold text-gray-900 mb-2">${item.price || '$0.00'}</div>
                  <span class="inline-block bg-emerald-50 text-emerald-700 text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full border border-emerald-100">In Stock</span>
                </div>
              </div>

              <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                <button
                  type="button"
                  onclick="window.auraAddWishlistToCart('${item.variant_id || ''}', this, '${item.url || ''}')"
                  class="aura-wishlist-cart-btn flex-1 sm:flex-none py-3 px-6 bg-black text-white text-xs font-extrabold uppercase tracking-widest rounded-full hover:bg-gray-800 transition-all shadow-md active:scale-95 flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                  <span>Add To Bag</span>
                </button>
                <button
                  type="button"
                  onclick="window.auraRemoveWishlist('${item.handle}')"
                  class="w-11 h-11 rounded-full bg-gray-100 hover:bg-rose-50 hover:text-rose-600 flex items-center justify-center text-gray-500 transition-all border border-gray-200 shrink-0"
                  aria-label="Remove item"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            </div>
          `).join('');
        } else {
          gridEl.className = 'grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6';
          gridEl.innerHTML = items.map(item => `
            <div class="aura-wishlist-card relative group bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between" data-handle="${item.handle}">
              
              <!-- Remove Icon Button -->
              <button
                type="button"
                onclick="window.auraRemoveWishlist('${item.handle}')"
                class="absolute top-3.5 right-3.5 z-10 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-gray-500 hover:text-rose-600 hover:bg-white transition-all shadow-md"
                aria-label="Remove item"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
              </button>

              <!-- Product Image -->
              <div class="aura-card-media relative aspect-[3/4] bg-gray-100 overflow-hidden">
                <a href="${item.url || '#'}" class="block w-full h-full">
                  <img src="${item.image || 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-1_600x.png'}" alt="${item.title || 'Product'}" width="600" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                </a>
                <span class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider text-gray-900 shadow-sm">In Stock</span>
              </div>

              <!-- Card Details & Actions -->
              <div class="p-5 flex flex-col justify-between flex-1">
                <div class="mb-4">
                  <span class="text-[10px] font-extrabold tracking-widest uppercase text-gray-400 block mb-1">AURA LUXURY</span>
                  <h3 class="text-sm font-bold text-gray-900 line-clamp-1 mb-1">
                    <a href="${item.url || '#'}" class="hover:text-black transition-colors">${item.title || 'Luxury Piece'}</a>
                  </h3>
                  <div class="text-sm font-extrabold text-gray-900">${item.price || '$0.00'}</div>
                </div>

                <button
                  type="button"
                  onclick="window.auraAddWishlistToCart('${item.variant_id || ''}', this, '${item.url || ''}')"
                  class="aura-wishlist-cart-btn w-full py-3.5 bg-black text-white text-xs font-extrabold uppercase tracking-widest rounded-full text-center hover:bg-gray-800 transition-all shadow-md active:scale-95 flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                  <span>Add To Bag</span>
                </button>
              </div>

            </div>
          `).join('');
        }
      }
    }

    // Global Action Wrappers
    window.auraRemoveWishlist = function(handle) {
      removeItem(handle);
    };

    window.auraAddWishlistToCart = function(variantId, btnEl, url) {
      addToCart(variantId, btnEl, url);
    };

    // Filter Buttons Listener
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-black', 'text-white', 'shadow-sm', 'active');
          b.classList.add('bg-transparent', 'text-gray-600');
        });
        btn.classList.add('bg-black', 'text-white', 'shadow-sm', 'active');
        btn.classList.remove('bg-transparent', 'text-gray-600');
        currentFilter = btn.dataset.filter;
        renderWishlist();
      });
    });

    // View Toggles
    viewGridBtn?.addEventListener('click', () => {
      currentView = 'grid';
      viewGridBtn.className = 'p-1.5 rounded-lg bg-black text-white transition-all';
      viewListBtn.className = 'p-1.5 rounded-lg text-gray-400 hover:text-black transition-all';
      renderWishlist();
    });

    viewListBtn?.addEventListener('click', () => {
      currentView = 'list';
      viewListBtn.className = 'p-1.5 rounded-lg bg-black text-white transition-all';
      viewGridBtn.className = 'p-1.5 rounded-lg text-gray-400 hover:text-black transition-all';
      renderWishlist();
    });

    // Sort Dropdown Change
    sortSelect?.addEventListener('change', renderWishlist);

    // Clear All Action
    clearBtn?.addEventListener('click', () => {
      if (confirm('Are you sure you want to clear all wishlist items?')) {
        saveWishlist([]);
        showToast('Wishlist cleared');
      }
    });

    // Share Wishlist Action
    shareBtn?.addEventListener('click', () => {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href);
        showToast('Wishlist link copied to clipboard! 📋');
      } else {
        showToast('Wishlist URL ready');
      }
    });

    // Move All To Bag Action
    moveAllBtn?.addEventListener('click', async () => {
      const items = getWishlist();
      if (items.length === 0) return;
      moveAllBtn.disabled = true;
      const originalText = moveAllBtn.innerHTML;
      moveAllBtn.innerHTML = `Moving...`;

      const cartItems = items.filter(i => i.variant_id).map(i => ({ id: parseInt(i.variant_id), quantity: 1 }));
      if (cartItems.length > 0) {
        try {
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: cartItems })
          });
          showToast('All items added to your bag! 🛍️');
          fetch('/cart.js').then(r => r.json()).then(cart => {
            document.querySelectorAll('.aura-cart-badge-pill').forEach(b => b.textContent = cart.item_count || 0);
          });
        } catch(e) {}
      } else {
        showToast('Please visit individual items to choose options.');
      }
      setTimeout(() => {
        moveAllBtn.disabled = false;
        moveAllBtn.innerHTML = originalText;
      }, 2000);
    });

    // Initial Render
    renderWishlist();
  });
</script>

{% stylesheet %}
  .aura-wishlist-page {
    min-height: 65vh;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aura Wishlist",
  "tag": "section",
  "class": "section-aura-wishlist",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title",
      "default": "My Wishlist"
    },
    {
      "type": "textarea",
      "id": "header_subtitle",
      "label": "Header Subtitle",
      "default": "Your saved fashion favorites and curated looks ready for checkout."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Recommendations Collection"
    }
  ]
}
{% endschema %}
