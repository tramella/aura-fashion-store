<div class="aura-addresses-page page-width py-12 md:py-16">
  <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-gray-200 pb-6 mb-8 gap-4">
    <div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">
        <span>Saved</span>
        <span class="aura-serif-italic font-normal">Addresses</span>
      </h1>
      <p class="text-xs text-gray-500 mt-1">Manage your shipping and billing addresses.</p>
    </div>
    <a href="{{ routes.account_url }}" class="aura-btn bg-gray-100 hover:bg-gray-200 text-black text-xs uppercase font-bold py-2.5 px-5 rounded-full transition-all">
      &larr; Back to Account
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {%- if customer.addresses.size > 0 -%}
      {%- for address in customer.addresses -%}
        <div class="bg-white rounded-3xl border border-gray-200/80 p-6 shadow-sm flex flex-col justify-between">
          <div>
            {%- if address == customer.default_address -%}
              <span class="inline-block px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-black text-white mb-3">Default Address</span>
            {%- endif -%}
            <p class="font-bold text-gray-900 text-base mb-1">{{ address.name }}</p>
            <p class="text-xs text-gray-600 leading-relaxed">{{ address.address1 }}</p>
            {%- if address.address2 != blank -%}
              <p class="text-xs text-gray-600 leading-relaxed">{{ address.address2 }}</p>
            {%- endif -%}
            <p class="text-xs text-gray-600 leading-relaxed">{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
            <p class="text-xs text-gray-600 leading-relaxed">{{ address.country }}</p>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="col-span-full text-center py-12 bg-gray-50/60 rounded-3xl border border-gray-100">
        <p class="text-sm font-bold text-gray-900 mb-1">No Saved Addresses</p>
        <p class="text-xs text-gray-500 max-w-xs mx-auto mb-4">Your saved addresses will appear here after your first order checkout.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .aura-addresses-page {
    min-height: 60vh;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aura Addresses",
  "tag": "section",
  "class": "section-aura-addresses",
  "settings": []
}
{% endschema %}
