<div class="aura-effortless-banner page-width">
  <div class="aura-effortless-card">
    <div class="aura-effortless-card__media">
      {%- if section.settings.image != blank -%}
        <img
          srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
          src="{{ section.settings.image | image_url: width: 1400 }}"
          sizes="100vw"
          alt="Effortless Elegance"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="aura-effortless-card__img"
        >
      {%- else -%}
        <div class="aura-effortless-card__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
      <div class="aura-effortless-card__overlay"></div>
    </div>

    <!-- Top Right Controls (← → matching media_1788970380422.png) -->
    <div class="aura-effortless-controls">
      <button type="button" class="aura-circle-control" aria-label="Previous slide">&larr;</button>
      <button type="button" class="aura-circle-control aura-circle-control--white" aria-label="Next slide">&rarr;</button>
    </div>

    <!-- Big Center Title -->
    <h2 class="aura-effortless-title">
      <span>Effortless</span>
      <span class="aura-serif-italic">Elegance</span>
    </h2>

    <!-- Bottom Left Description -->
    <p class="aura-effortless-desc">
      {{ section.settings.text | default: 'Thoughtfully curated collections designed for modern living, blending timeless aesthetics with a commitment to sustainability and quality.' }}
    </p>

    <!-- Bottom Centered White Pill Button -->
    <div class="aura-effortless-action">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="aura-btn aura-btn--white">
        {{ section.settings.button_label | default: 'Explore the Collections' }}
      </a>
    </div>
  </div>
</div>

{% stylesheet %}
  .aura-effortless-banner {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .aura-effortless-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 70vh;
    min-height: 520px;
    max-height: 700px;
    width: 100%;
    background-color: #CFC8BC;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
  }

  .aura-effortless-card__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .aura-effortless-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aura-effortless-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #E5E0D8;
  }

  .aura-effortless-card__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .aura-effortless-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.15) 50%, rgba(0, 0, 0, 0.4) 100%);
    z-index: 2;
  }

  .aura-effortless-controls {
    position: absolute;
    top: 2rem;
    right: 2rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .aura-effortless-title {
    position: absolute;
    top: 38%;
    left: 6%;
    transform: translateY(-50%);
    z-index: 3;
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.05;
    margin: 0;
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
  }

  .aura-effortless-desc {
    position: absolute;
    bottom: 7.5rem;
    left: 6%;
    z-index: 3;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.95);
    max-width: 440px;
    margin: 0;
  }

  .aura-effortless-action {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
  }

  .aura-effortless-action .aura-btn--white {
    background-color: #FFFFFF !important;
    color: #0F0F11 !important;
    border-radius: 9999px !important;
    padding: 14px 34px !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15) !important;
    white-space: nowrap;
  }

  .aura-effortless-action .aura-btn--white:hover {
    background-color: #F3F4F6 !important;
    transform: translateY(-2px) !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign Banner",
  "tag": "section",
  "class": "section-aura-campaign-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Thoughtfully curated collections designed for modern living, blending timeless aesthetics with a commitment to sustainability and quality."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Campaign Banner"
    }
  ]
}
{% endschema %}
