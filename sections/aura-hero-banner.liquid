<div class="aura-hero-luneva w-full relative overflow-hidden">
  <div class="aura-hero-luneva-card w-full" id="AuraHeroCard">
    <!-- Slide 1 -->
    <div class="aura-hero-slide is-active">
      <div class="aura-hero-luneva-card__media">
        {%- if section.settings.image != blank -%}
          <img
            srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
            src="{{ section.settings.image | image_url: width: 2000 }}"
            sizes="100vw"
            alt="{{ section.settings.heading_1 | escape }}"
            fetchpriority="high"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="aura-hero-luneva-card__img"
          >
        {%- else -%}
          <div class="aura-hero-luneva-card__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="aura-hero-luneva-card__overlay"></div>
      </div>

      <div class="aura-hero-luneva-card__content">
        <div class="aura-hero-luneva-card__text-wrap">
          <h1 class="aura-hero-luneva-title">
            <span>{{ section.settings.heading_1 | default: 'Timeless Fashion,' }}</span>
            <span class="aura-serif-italic">{{ section.settings.heading_2 | default: 'Conscious Choices.' }}</span>
          </h1>

          <p class="aura-hero-luneva-desc">
            {{ section.settings.text | default: 'Sustainably designed, effortlessly worn. Our pieces are made with premium materials, and wardrobe that stands the test of time.' }}
          </p>

          <div class="aura-hero-luneva-action">
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="aura-btn aura-btn--white">
              {{ section.settings.button_label | default: 'Explore the Collections' }}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="aura-hero-slide">
      <div class="aura-hero-luneva-card__media">
        {%- if section.settings.image_2 != blank -%}
          <img
            src="{{ section.settings.image_2 | image_url: width: 2000 }}"
            alt="Elevated Essentials"
            loading="lazy"
            width="2000"
            height="1000"
            class="aura-hero-luneva-card__img"
          >
        {%- else -%}
          <div class="aura-hero-luneva-card__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="aura-hero-luneva-card__overlay"></div>
      </div>

      <div class="aura-hero-luneva-card__content">
        <div class="aura-hero-luneva-card__text-wrap">
          <h1 class="aura-hero-luneva-title">
            <span>Elevated Essentials,</span>
            <span class="aura-serif-italic">Modern Silhouettes.</span>
          </h1>

          <p class="aura-hero-luneva-desc">
            Discover our Spring / Summer 2026 collection, meticulously crafted from luxury organic fabrics.
          </p>

          <div class="aura-hero-luneva-action">
            <a href="/collections/all" class="aura-btn aura-btn--white">
              Shop New Arrivals
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Right Slider Controls (Arrows ← → matching media_1788969994671.png) -->
    <div class="aura-hero-luneva-controls">
      <button type="button" class="aura-circle-control" id="AuraHeroPrev" aria-label="Previous slide">&larr;</button>
      <button type="button" class="aura-circle-control aura-circle-control--white" id="AuraHeroNext" aria-label="Next slide">&rarr;</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroCard = document.getElementById('AuraHeroCard');
    if (!heroCard) return;

    const slides = heroCard.querySelectorAll('.aura-hero-slide');
    const prevBtn = document.getElementById('AuraHeroPrev');
    const nextBtn = document.getElementById('AuraHeroNext');
    let currentIndex = 0;
    let autoSlideTimer = null;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
    }

    function startAutoSlide() {
      stopAutoSlide();
      autoSlideTimer = setInterval(() => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      }, 5000);
    }

    function stopAutoSlide() {
      if (autoSlideTimer) clearInterval(autoSlideTimer);
    }

    prevBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      showSlide(currentIndex);
      startAutoSlide();
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
      startAutoSlide();
    });

    heroCard.addEventListener('mouseenter', stopAutoSlide);
    heroCard.addEventListener('mouseleave', startAutoSlide);

    startAutoSlide();
  });
</script>

{% stylesheet %}
  .aura-hero-luneva {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .aura-hero-luneva-card {
    position: relative;
    border-radius: 0 !important;
    overflow: hidden;
    height: 85vh;
    min-height: 620px;
    max-height: 850px;
    display: flex;
    align-items: center;
    width: 100% !important;
    background-color: #CFC8BC;
  }

  .aura-hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    display: flex;
    align-items: center;
    transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1), visibility 600ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .aura-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .aura-hero-luneva-card__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .aura-hero-luneva-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .aura-hero-luneva-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #E5E0D8;
  }

  .aura-hero-luneva-card__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .aura-hero-luneva-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0.18) 55%, rgba(0, 0, 0, 0) 100%);
    z-index: 2;
  }

  .aura-hero-luneva-card__content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: clamp(3rem, 8vw, 9rem);
    padding-right: 3rem;
    box-sizing: border-box;
  }

  .aura-hero-luneva-card__text-wrap {
    max-width: 580px;
    color: #FFFFFF;
  }

  .aura-hero-luneva-title {
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: #FFFFFF;
  }

  .aura-hero-luneva-title span {
    display: block;
  }

  .aura-serif-italic {
    font-family: var(--aura-font-serif-italic);
    font-style: italic;
    font-weight: 400;
  }

  .aura-hero-luneva-desc {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 2.5rem;
    max-width: 480px;
    font-weight: 400;
  }

  .aura-hero-luneva-action .aura-btn--white {
    background-color: #FFFFFF !important;
    color: #0F0F11 !important;
    border-radius: 9999px !important;
    padding: 14px 34px !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12) !important;
  }

  .aura-hero-luneva-action .aura-btn--white:hover {
    background-color: #F3F4F6 !important;
    transform: translateY(-2px) !important;
  }

  .aura-hero-luneva-controls {
    position: absolute;
    bottom: 3rem;
    right: 4rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .aura-circle-control {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    color: #FFFFFF;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
  }

  .aura-circle-control:hover {
    background: rgba(255, 255, 255, 0.45);
    transform: scale(1.08);
  }

  .aura-circle-control--white {
    background: #FFFFFF;
    color: #0F0F11;
  }

  .aura-circle-control--white:hover {
    background: #F3F4F6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aura Full-Width Hero",
  "tag": "section",
  "class": "section-aura-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image (Slide 1)"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading Line 1",
      "default": "Timeless Fashion,"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading Line 2 (Italic)",
      "default": "Conscious Choices."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Sustainably designed, effortlessly worn. Our pieces are made with premium materials, and wardrobe that stands the test of time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Hero Image (Slide 2)"
    }
  ],
  "presets": [
    {
      "name": "Aura Full-Width Hero"
    }
  ]
}
{% endschema %}
