<div class="aura-hero-luneva page-width">
  <div class="aura-hero-luneva-card" id="AuraHeroCard">
    <!-- Slide 1 -->
    <div class="aura-hero-slide is-active">
      <div class="aura-hero-luneva-card__media">
        {%- if section.settings.image != blank -%}
          <img
            srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
            src="{{ section.settings.image | image_url: width: 1400 }}"
            sizes="100vw"
            alt="{{ section.settings.heading_1 | escape }}"
            fetchpriority="high"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="aura-hero-luneva-card__img"
          >
        {%- else -%}
          <div class="aura-hero-luneva-card__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="aura-hero-luneva-card__overlay"></div>
      </div>

      <div class="aura-hero-luneva-card__content">
        <div class="aura-hero-luneva-card__text-wrap">
          <h1 class="aura-hero-luneva-title">
            <span>{{ section.settings.heading_1 | default: 'Timeless Fashion,' }}</span>
            <span class="aura-serif-italic">{{ section.settings.heading_2 | default: 'Conscious Choices.' }}</span>
          </h1>

          <p class="aura-hero-luneva-desc">
            {{ section.settings.text | default: 'Sustainably designed, effortlessly worn. Our pieces are made with premium materials, and wardrobe that stands the test of time.' }}
          </p>

          <div class="aura-hero-luneva-action">
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="aura-btn aura-btn--white">
              {{ section.settings.button_label | default: 'Explore the Collections' }}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="aura-hero-slide">
      <div class="aura-hero-luneva-card__media">
        {%- if section.settings.image_2 != blank -%}
          <img
            src="{{ section.settings.image_2 | image_url: width: 1400 }}"
            alt="Elevated Essentials"
            loading="lazy"
            width="1400"
            height="800"
            class="aura-hero-luneva-card__img"
          >
        {%- else -%}
          <div class="aura-hero-luneva-card__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="aura-hero-luneva-card__overlay"></div>
      </div>

      <div class="aura-hero-luneva-card__content">
        <div class="aura-hero-luneva-card__text-wrap">
          <h1 class="aura-hero-luneva-title">
            <span>Elevated Essentials,</span>
            <span class="aura-serif-italic">Modern Silhouettes.</span>
          </h1>

          <p class="aura-hero-luneva-desc">
            Discover our Spring / Summer 2026 collection, meticulously crafted from luxury organic fabrics.
          </p>

          <div class="aura-hero-luneva-action">
            <a href="/collections/all" class="aura-btn aura-btn--white">
              Shop New Arrivals
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Right Slider Circles -->
    <div class="aura-hero-luneva-controls">
      <button type="button" class="aura-circle-control" id="AuraHeroPrev" aria-label="Previous slide">&lsaquo;</button>
      <button type="button" class="aura-circle-control aura-circle-control--white" id="AuraHeroNext" aria-label="Next slide">&rsaquo;</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroCard = document.getElementById('AuraHeroCard');
    if (!heroCard) return;

    const slides = heroCard.querySelectorAll('.aura-hero-slide');
    const prevBtn = document.getElementById('AuraHeroPrev');
    const nextBtn = document.getElementById('AuraHeroNext');
    let currentIndex = 0;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
    }

    prevBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      showSlide(currentIndex);
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
    });

    setInterval(() => {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
    }, 6000);
  });
</script>

{% stylesheet %}
  .aura-hero-luneva {
    padding-top: 1.25rem;
    padding-bottom: 3rem;
  }

  .aura-hero-luneva-card {
    position: relative;
    border-radius: var(--aura-radius-card, 28px);
    overflow: hidden;
    min-height: 580px;
    display: flex;
    align-items: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    background-color: #CFC8BC;
  }

  .aura-hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1), visibility 600ms cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
  }

  .aura-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  @media (max-width: 768px) {
    .aura-hero-luneva-card {
      min-height: 380px;
    }
  }

  .aura-hero-luneva-card__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .aura-hero-luneva-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aura-hero-luneva-card__placeholder {
    width: 100%;
    height: 100%;
    background: #C2BBB0;
  }

  .aura-hero-luneva-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.12) 65%);
    z-index: 2;
  }

  .aura-hero-luneva-card__content {
    position: relative;
    z-index: 3;
    padding: 4.5rem 4rem;
    max-width: 700px;
  }

  @media (max-width: 768px) {
    .aura-hero-luneva-card__content {
      padding: 2rem 1.25rem;
    }
  }

  .aura-hero-luneva-title {
    font-size: var(--aura-fs-hero-title, clamp(2.8rem, 5.5vw, 4.8rem)) !important;
    line-height: 1.05 !important;
    color: #FFFFFF !important;
    margin: 0 0 1.25rem 0 !important;
    display: flex;
    flex-direction: column;
  }

  .aura-hero-luneva-desc {
    font-size: clamp(0.92rem, 1.8vw, 1.15rem) !important;
    line-height: 1.5 !important;
    color: rgba(255, 255, 255, 0.95) !important;
    margin: 0 0 2rem 0 !important;
    max-width: 520px;
  }

  .aura-hero-luneva-controls {
    position: absolute;
    bottom: 28px;
    right: 28px;
    z-index: 6;
    display: flex;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .aura-hero-luneva-controls {
      bottom: 16px;
      right: 16px;
    }
  }

  .aura-circle-control {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    font-size: 1.3rem;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aura-circle-control--white {
    background: #FFFFFF;
    color: #0F0F11;
    font-weight: 800;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lunéva Hero Slider",
  "tag": "section",
  "class": "section-luneva-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image Slide 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Hero Image Slide 2"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading Line 1 (Sans)",
      "default": "Timeless Fashion,"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading Line 2 (Italic Serif)",
      "default": "Conscious Choices."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Sustainably designed, effortlessly worn. Our pieces are made with premium materials, and wardrobe that stands the test of time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Lunéva Hero Slider"
    }
  ]
}
{% endschema %}
